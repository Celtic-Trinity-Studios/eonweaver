php_value max_execution_time 300
php_value memory_limit 256M

RewriteEngine On
# Force canonical host + HTTPS.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.eonweaver\.com$ [NC]
RewriteRule ^ https://eonweaver.com%{REQUEST_URI} [L,R=301]

# Normalize index files to clean root/path URLs.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.(php|html?)[\s?] [NC]
RewriteRule ^ %1 [L,R=301]

# Normalize trailing slash on non-directory paths.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} .+/$
RewriteRule ^(.+)/$ /$1 [L,R=301]

# Drop unexpected query strings on homepage (keep verification status links).
RewriteCond %{REQUEST_URI} ^/$
RewriteCond %{QUERY_STRING} .+
RewriteCond %{QUERY_STRING} !^(verified=1|verify_error=(expired|invalid))$ [NC]
RewriteRule ^$ /? [L,R=301]

# SPA deep links — do NOT emit 404 before index.html fallback. Known routes like
# /campaign-slug/town-slug plus any newly added frontend paths must survive refresh.

# SPA routing — serve index.html for non-file, non-directory requests
# BUT skip .js, .css, and other static assets so dynamic imports work
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(js|css|gif|jpg|jpeg|png|ico|json|txt|woff|woff2|svg|webp|map)$ [NC]
RewriteRule ^ index.html [L]

ErrorDocument 404 /404.html
