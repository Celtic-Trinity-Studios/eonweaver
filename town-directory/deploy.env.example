# FTP credentials — NEVER commit real passwords. Gitignored filenames below.
#
# ── Recommended: two files on disk (no swapping) ─────────────────────────────
#
#   deploy.env.worldscribe   staging / dev site (worldscribe.online)
#       EW_FTP_USER should be uNNNNNNNN.worldscribe.online (hPanel FTP for that subdomain)
#
#   deploy.env.eonweaver     production (eonweaver.com)
#       EW_FTP_USER should be uNNNNNNNN.eonweaver.com
#       node deploy.cjs eonweaver sets EW_ALLOW_EONWEAVER_DEPLOY automatically for that file.
#
#   deploy.env               optional legacy default when you run `node deploy.cjs` with no args
#
# ── Which command loads which file ───────────────────────────────────────────────
#
#   .\deploy_worldscribe.ps1              → deploy.env.worldscribe (fallback: deploy.env)
#   .\deploy_worldscribe.ps1 -EnvFile X   → exact file path
#
#   node deploy.cjs worldscribe           → deploy.env.worldscribe
#   node deploy.cjs eonweaver             → deploy.env.eonweaver
#   node deploy.cjs --env-file=custom.env → custom file
#   node deploy.cjs                       → deploy.env
#
#   .\deploy_live.ps1                     → deploy.env.eonweaver (fallback: deploy.env)
#
# Discord deploy posts: `deploy_live.ps1` / `deploy_worldscribe.ps1` call **local**
# `node discord_deploy_notify.mjs` (see `.env.discord.example`). `node deploy.cjs` alone does not
# ping Discord — run the same script manually after FTP if you use deploy.cjs only.

EW_FTP_HOST=your.ftp.host
EW_FTP_USER=your_ftp_username
EW_FTP_PASS=your_ftp_password
EW_FTP_SECURE=false

# Optional: path AFTER FTP login for **eonweaver production** only (deploy_live.ps1 / deploy.cjs eonweaver).
# Hostinger u*.eonweaver.com is usually already the site root — leave unset (empty).
# Wrong folder → 550 on upload or 404 on assets. Do NOT set public_html unless you know you need it.
# EW_FTP_EONWEAVER_REMOTE_PATH=
#
# Legacy: deploy_live.ps1 ignores EW_FTP_REMOTE_PATH unless EW_USE_LEGACY_FTP_REMOTE_PATH=true
# (avoids double-public_html 550). Worldscribe still documents EW_FTP_REMOTE_PATH for non-domain FTP.
# EW_FTP_REMOTE_PATH=

# WorldScribe script only: optional extra path if uploads land above web root (rare).
# EW_FTP_WORLDSCRIBE_REMOTE_PATH=

# Legacy: only if you still use a single deploy.env for production:
# EW_ALLOW_EONWEAVER_DEPLOY=true

# deploy.cjs uploads config.php from this repo. Each host needs its own MySQL settings —
# restore the correct remote config.php after deploy if login/API breaks.
