# Copy to .env.discord (gitignored). Used by discord_controller.js, discord_deploy_notify.mjs, etc.
DISCORD_TOKEN=

# Optional when the bot is in more than one server:
# DISCORD_GUILD_ID=

# ── Onboarding (#start-here + edition buttons — discord_setup_onboarding.mjs) ──
# WorldScribe “Start here” category (Server Settings → Widget, or right‑click category → Copy ID):
# DISCORD_CATEGORY_START_HERE=1502615531809935471
# Filled in by: node discord_setup_onboarding.mjs
# DISCORD_ROLE_EDITION_35E=
# DISCORD_ROLE_EDITION_5E=
# DISCORD_ROLE_EDITION_5E2024=
# DISCORD_ROLE_SUSPICIOUS=
# DISCORD_CHANNEL_ONBOARDING=
# DISCORD_ONBOARDING_MESSAGE_ID=
# DISCORD_ONBOARDING_SITE_URL=https://eonweaver.com
# Lore categories (node discord_setup_edition_lore.mjs) — optional existing category IDs:
# DISCORD_CATEGORY_LORE_35E=1480714569143029778
# DISCORD_CATEGORY_LORE_5E=1480715149873778789
# DISCORD_CATEGORY_LORE_5E2024=
# Comma-separated staff role IDs that can see every lore category:
# DISCORD_LORE_STAFF_ROLE_IDS=

# ── Deploy notifications (local only — discord_deploy_notify.mjs after FTP) ──
# Bot needs Send Messages + Embed Links in each channel.
DISCORD_DEPLOY_CHANNEL_DEV_35E=1480714569143029779
DISCORD_DEPLOY_CHANNEL_DEV_5E=1480715196673560596
# DISCORD_DEPLOY_CHANNEL_DEV=
DISCORD_DEPLOY_CHANNEL_LIVE=
